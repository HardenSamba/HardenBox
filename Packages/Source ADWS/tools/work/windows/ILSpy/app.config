<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <!-- Enabling support for International Resource Identifiers (IRIs).  -->
    <section name="uri" type="System.Configuration.UriSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
  </configSections>
  <appSettings>       
    
    <!--The following ADWS configuration parameters determine how the ADWS service handles the traffic generated by 
    administrators managing AD DS and AD LDS instances and Active Directory Database Mounting Tool instances by 
    using Active Directory PowerShell snap-in or Active Directory Administrative Center. Important Note: It is not
    recommended that you change the default values of these parameters, unless they prevent you from efficiently 
    administering directory service instances supported by the ADWS service through Active Directory PowerShell 
    snap-in or Active Directory Administrative Center.-->
    
    <!--MaxPoolConnections specifies the maximum number of LDAP connections for each directory service instance that
    is supported by the ADWS service running on a given Windows Server. For example, if 
    MaxPoolConnection on a particular Windows Server is set to 10 and there are 3 directory service
    instances running on this server, each of these directory service instances is configured to have a maximum of 
    10 LDAP connections that will be successfully supported by the ADWS service running on this Windows Server.
    Set this parameter to a higher value if you notice that client service requests are timing out while 
    waiting for an LDAP connection. 
    
    Note: To improve performance, ADWS service on a Windows Server maintains a separate LDAP connection
    pool for every directory service instance that is running on this server. For example if your Windows Server
    is a domain controller (thus running the AD DS server role) and also a global catalog (GC) server, and if it
    is running two AD LDS instances and one Active Directory Database Mounting Tool instance, (a total of five directory
    service instances), the ADWS service on this Windows Server will maintain five separate LDAP 
    connection pools. (Since a GC does not share the same LDAP port as AD DS, it is considered a separate directory 
    instance.)-->
    
    <add key="MaxPoolConnections" value="10" />
    
    <!--MaxPercentageReservedConnections specifies the maximum percentage of LDAP connections that can be used for
    performing search query operations for each directory service instance that is supported by the ADWS service on a given 
    Windows Server. Set this parameter to a higher percentage if the ADWS service on this 
    Windows Server is mostly used for running search queries.-->
    
    <add key="MaxPercentageReservedConnections" value="50" />    
     
    <!--MaxConnectionsPerUser specifies the maximum number of LDAP connections that ADWS service is configured to 
    associate with a particular set of client credentials for each directory service instance running on a given Windows
    Server. Set this parameter to a higher value if you are experiencing more than 5 concurrent LDAP
    client requests to a single directory service instance running on your Windows Server. The value of 
    MaxConnectionsPerUser cannot be greater than the value of MaxPoolConnection. If the value of MaxConnectionsPerUser 
    is equal to the value of MaxPoolConnection, it results in a single set of client credentials being associated with 
    all available LDAP connections for a given directory service instance.-->

    <add key="MaxConnectionsPerUser" value="5" />    
   
    <!--MaxEnumContextExpiration specifies the time period during which ADWS service processes and retrieves the results
    of a search query request from a client. Caution: Changing the default value of this parameter is strongly discouraged.
    Most of the search results are returned within 30 minutes.-->

    <add key="MaxEnumContextExpiration" value="00:30:00" />
    
    <!--MaxPullTimeout specifies the maximum timeout value that a client can set when retrieving one page worth of search
    results. Set this parameter to a higher value if slow WAN traffic results in a timeout value for returning one page of
    search results being longer than 2 minutes. Note: ADWS service processes search requests from clients in the following 
    manner: a client submits a search request. ADWS service establishes a search context and returns a search context ID to
    the client. Using this search context ID, client issues a page request to extract the search results specifying how 
    many LDAP objects can be returned per page.-->
    
    <add key="MaxPullTimeout" value="00:02:00" />    
      
    <!--MaxEnumCtxsPerSession specifies the maximum number of search requests that can be submitted over a single client 
    session with a Windows Server that is supported by the ADWS service running on this server-->

    <add key="MaxEnumCtxsPerSession" value="5" />
    
    <!--MaxEnumCtxsTotal specifies the maximum number of search requests that can be submitted over all active client 
    sessions with a Windows Server that are supported by the ADWS service running on this server.-->
    
    <add key="MaxEnumCtxsTotal" value="100" />    
      
    <!--MaxConcurrentCalls specifies the maximum number of service requests that the ADWS service is configured to process 
    at a given time. Set a higher value to this parameter if the ADWS service on your Windows Server must 
    be able to process a greater load of service requests at any given time.-->

    <add key="MaxConcurrentCalls" value="32" />
    
    <!--MaxConcurrentSessions specifies the maximum number of client sessions that the ADWS service can accept at any 
    given time. Set this parameter to a higher value if the ADWS service on your Windows Server must be able
    to accept more than 500 concurrent client sessions at any given time.-->
    
    <add key="MaxConcurrentSessions" value="500" />

    <!--OperationTimeout specifies the timeout limit for ADWS service-based query request. Set this parameter
    to a higher value if you expect your query to return an exceptionally large results set that might take longer than 2 minutes
    to retrieve.-->

    <add key="OperationTimeout" value="00:02:00" />

  </appSettings>
  <system.serviceModel>
    <behaviors>
    </behaviors>
    <services>
    </services>
    <bindings>
      <netTcpBinding>
        
        <!--MaxReceivedMessageSize specifies the maximum message request size that a client can send to the directory 
        service instances that are supported by the ADWS service. For example, if MaxConcurrentCalls is set to 32 and 
        MaxReceivedMessageSize is set to 1MB, the ADWS service is configured to process a maximum of 32MB in client 
        message requests at any given time.-->
        
        <binding name="ActiveDirectoryWebServicesNetTcpBindingConfiguration"
                 maxReceivedMessageSize="1048576"
                 receiveTimeout="00:10:00" >
          
          <!--MaxStringContentLength specifies the maximum string size of an LDAP attribute that the ADWS service is 
          configured to process in a message request sent by a client to a directory service instance that is supported 
          by the ADWS service.-->
          
          <readerQuotas maxArrayLength="16384" 
                        maxStringContentLength="32768" 
                        maxDepth="10" />
        </binding>
      </netTcpBinding>
    </bindings>
  </system.serviceModel>
  <!-- Enabling IRI parsing rules. -->
  <uri>
    <iriParsing enabled="true" />
  </uri>
</configuration>