#!/bin/bash

set -e

. /usr/share/debconf/confmodule

db_input high hb-common/profile || true
db_go
db_get hb-common/profile
profile=$RET

for question in hostname admin-user ssh-port ssh-allowed-cidr; do
	db_input high "hb-common/$question" || true
done
if [ "$profile" = "gnome" ]; then
	for question in desktop-user network-interface ip-address gateway dns; do
		db_input high "hb-common/$question" || true
	done
fi
db_go

exit 0