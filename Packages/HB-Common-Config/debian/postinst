#!/bin/bash

set -e

if [ "$1" = "configure" ]; then
    . /usr/share/debconf/confmodule
    db_get hb-common/profile; profile=$RET
    db_get hb-common/hostname; hostname_value=$RET
    db_get hb-common/admin-user; admin_user=$RET
    db_get hb-common/ssh-port; ssh_port=$RET
    db_get hb-common/ssh-allowed-cidr; ssh_allowed_cidr=$RET
    db_get hb-common/desktop-user; desktop_user=${RET:-$admin_user}
    db_get hb-common/network-interface; network_interface=$RET
    db_get hb-common/ip-address; ip_address=$RET
    db_get hb-common/gateway; gateway=$RET
    db_get hb-common/dns; dns_servers=$RET

    if [ -z "$hostname_value" ] || [ -z "$admin_user" ] || \
        [ -z "$ssh_port" ] || [ -z "$ssh_allowed_cidr" ]; then
        printf 'ERREUR: le nom d\x27hote, le compte administrateur et les parametres SSH sont obligatoires.\n' >&2
        exit 1
    fi
    if ! [[ $ssh_port =~ ^[0-9]+$ ]] || ((ssh_port < 1 || ssh_port > 65535)); then
        printf 'ERREUR: le port SSH doit etre compris entre 1 et 65535.\n' >&2
        exit 1
    fi
    if [ "$profile" = "gnome" ] && [ -z "$desktop_user" ]; then
        printf 'ERREUR: le profil GNOME exige le compte bureau.\n' >&2
        exit 1
    fi
    if [ -n "$network_interface$ip_address$gateway$dns_servers" ] && \
        { [ -z "$network_interface" ] || [ -z "$ip_address" ] || \
          [ -z "$gateway" ] || [ -z "$dns_servers" ]; }; then
        printf 'ERREUR: la configuration reseau exige interface, adresse, passerelle et DNS.\n' >&2
        exit 1
    fi

    install -d -o root -g root -m 0700 /var/lib/hardenbox
    umask 077
    {
        printf 'PROFILE=%q\n' "$profile"
        printf 'HOSTNAME_VALUE=%q\n' "$hostname_value"
        printf 'ADMIN_USER=%q\n' "$admin_user"
        printf 'SSH_PORT=%q\n' "$ssh_port"
        printf 'SSH_ALLOWED_CIDR=%q\n' "$ssh_allowed_cidr"
        printf 'DESKTOP_USER=%q\n' "$desktop_user"
        printf 'NETWORK_INTERFACE=%q\n' "$network_interface"
        printf 'IP_ADDRESS=%q\n' "$ip_address"
        printf 'GATEWAY=%q\n' "$gateway"
        printf 'DNS_SERVERS=%q\n' "$dns_servers"
    } >/var/lib/hardenbox/hb-common.conf
    db_stop

    systemctl enable hb-common-bootstrap.service
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl start --no-block hb-common-bootstrap.service
    fi
fi

exit 0