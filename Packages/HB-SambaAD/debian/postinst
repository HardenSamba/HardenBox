#!/bin/bash

set -e

if [ -x /opt/openrsat/OpenRSAT ]; then
    install -d -o root -g root -m 0755 /usr/local/bin /usr/local/libexec
    cat >/usr/local/libexec/hardenbox-openrsat <<'EOF'
#!/bin/sh
unset GTK_MODULES
exec /opt/openrsat/OpenRSAT "$@"
EOF
    chmod 0755 /usr/local/libexec/hardenbox-openrsat
    ln -sfn /usr/local/libexec/hardenbox-openrsat /usr/local/bin/openrsat
    ln -sfn /usr/local/libexec/hardenbox-openrsat /usr/local/bin/OpenRSAT
    if [ -f /usr/share/applications/OpenRSAT.desktop ]; then
        sed -i 's|^Exec=.*|Exec=/usr/local/libexec/hardenbox-openrsat|' \
            /usr/share/applications/OpenRSAT.desktop
    fi
fi

if [ "$1" = "configure" ]; then
    if [ "$(id -u)" -ne 0 ]; then
        printf 'ERREUR: la configuration HardenBox doit etre lancee en root.\n' >&2
        exit 1
    fi

    # Le module HGPM est installe par la promotion lorsque son option est cochee.

    # Dans le chroot de l'installateur, le DVD est monte sur /media/cdrom.
    for media_pool in /cdrom/pool /media/cdrom/pool /media/cdrom0/pool; do
        [ -d "$media_pool" ] || continue
        adws_package=$(find "$media_pool" -type f -name 'hb-sambadws_*_all.deb' -print -quit)
        if [ -z "$adws_package" ]; then
            printf 'ERREUR: paquet hb-sambadws absent du media HardenBox.\n' >&2
            exit 1
        fi
        install -d -o root -g root -m 0755 /var/cache/hardenbox/packages
        install -o root -g root -m 0644 "$adws_package" \
            /var/cache/hardenbox/packages/hb-sambadws.deb
        break
    done

    systemctl enable hb-sambaad-setup-web.service
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl start --no-block hb-sambaad-setup-web.service
    fi
fi

exit 0
