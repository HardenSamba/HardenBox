#!/bin/bash

set -Eeuo pipefail

state_dir=/var/lib/hardenbox
install -d -o root -g root -m 0700 "$state_dir"

notify() {
    local message=$1 terminal
    printf '%s\n' "$message"
    printf '%s\n' "$message" >/var/lib/hardenbox/hb-common.result
    chmod 0644 /var/lib/hardenbox/hb-common.result
    for terminal in /dev/pts/[0-9]* /dev/tty[0-9]*; do
        [[ -c $terminal && -w $terminal ]] || continue
        printf '\r\n%s\r\n' "$message" 2>/dev/null >"$terminal" || true
    done
}

config_file=$state_dir/hb-common.conf
if [[ ! -r $config_file ]]; then
    profile=server
    [[ -x /usr/bin/gnome-shell || -x /usr/sbin/gdm3 ]] && profile=gnome
    hostname_value=$(< /etc/hostname)
    admin_user=$(getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $1 != "nobody" { print $1; exit }')
    [[ -n $hostname_value && -n $admin_user ]] || {
        notify "HB-Common: ECHEC de l'installation. Impossible de reconstruire la configuration."
        exit 1
    }
    (
    umask 077
    {
        printf 'PROFILE=%q\n' "$profile"
        printf 'HOSTNAME_VALUE=%q\n' "$hostname_value"
        printf 'ADMIN_USER=%q\n' "$admin_user"
        printf 'SSH_PORT=%q\n' 22
        printf 'SSH_ALLOWED_CIDR=%q\n' 0.0.0.0/0
        printf 'DESKTOP_USER=%q\n' "$admin_user"
        printf 'NETWORK_INTERFACE=%q\n' ''
        printf 'IP_ADDRESS=%q\n' ''
        printf 'GATEWAY=%q\n' ''
        printf 'DNS_SERVERS=%q\n' ''
    } >"$config_file"
    )
    notify "HB-Common: configuration reconstruite depuis le systeme installe."
fi
source "$config_file"

if [[ -z $ADMIN_USER ]]; then
    ADMIN_USER=$(getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $1 != "nobody" { print $1; exit }')
fi
[[ -n $ADMIN_USER ]] || {
    notify "HB-Common: ECHEC de l'installation. Aucun compte utilisateur Debian disponible."
    exit 1
}
if [[ $PROFILE == "gnome" && -z $DESKTOP_USER ]]; then
    DESKTOP_USER=$ADMIN_USER
fi

exec 9>/run/lock/hardenbox-bootstrap.lock
flock 9

apt_config=$(mktemp)
cleanup() {
    local status=$?
    rm -f -- "$apt_config"
    if ((status != 0)); then
        if [[ ${HARDENBOX_INSTALLER:-0} == 1 ]]; then
            notify "HB-Common: ECHEC de l'installation. Consultez: /var/log/hardenbox-installer.log"
        else
            notify "HB-Common: ECHEC de l'installation. Consultez: journalctl -u hb-common-bootstrap.service"
        fi
    fi
}
trap cleanup EXIT
printf 'DPkg::Lock::Timeout "-1";\n' >"$apt_config"
export APT_CONFIG="$apt_config"

arguments=(
    --profile "$PROFILE"
    --hostname "$HOSTNAME_VALUE"
    --admin-user "$ADMIN_USER"
    --ssh-port "$SSH_PORT"
    --ssh-allowed-cidr "$SSH_ALLOWED_CIDR"
)
if [[ $PROFILE == "gnome" ]]; then
    arguments+=(
        --desktop-user "$DESKTOP_USER"
    )
fi
if [[ -n $NETWORK_INTERFACE ]]; then
    arguments+=(
        --network-interface "$NETWORK_INTERFACE"
        --ip-address "$IP_ADDRESS"
        --gateway "$GATEWAY"
        --dns "$DNS_SERVERS"
    )
fi
HARDENBOX_INSTALLER=${HARDENBOX_INSTALLER:-0} \
    /usr/sbin/deploy-debian13.sh "${arguments[@]}"

printf '%s\n' "$PROFILE" >/var/lib/hardenbox/hb-common.completed
rm -f -- "$config_file"
systemctl disable hb-common-bootstrap.service || true
notify "HB-Common: installation du profil $PROFILE terminee avec succes. Vous devez redemarrer la machine: systemctl reboot"
