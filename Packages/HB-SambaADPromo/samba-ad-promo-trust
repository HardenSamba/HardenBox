#!/bin/sh

desktop_dir=$(xdg-user-dir DESKTOP 2>/dev/null || true)
for directory in "$desktop_dir" "$HOME/Bureau" "$HOME/Desktop"; do
    [ -n "$directory" ] && [ "$directory" != "$HOME" ] || continue
    launcher="$directory/SambaADPromo.desktop"
    [ -f "$launcher" ] || continue
    [ -x "$launcher" ] || chmod u+x "$launcher" 2>/dev/null || true
    trusted=$(gio info -a metadata::trusted "$launcher" 2>/dev/null | sed -n 's/^ *metadata::trusted: //p')
    [ "$trusted" = "true" ] || gio set -t string "$launcher" metadata::trusted true 2>/dev/null || true
done
exit 0
