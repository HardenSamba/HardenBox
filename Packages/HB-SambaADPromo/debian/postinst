#!/bin/bash

set -e

if [ "$1" = "configure" ]; then
    systemctl disable hb-sambaad-setup-web.service 2>/dev/null || true
    if [ -d /run/systemd/system ]; then
        systemctl stop hb-sambaad-setup-web.service 2>/dev/null || true
    fi
    if [ -x /opt/openrsat/OpenRSAT ]; then
        install -d -o root -g root -m 0755 /usr/local/bin /usr/local/libexec
        cat >/usr/local/libexec/hardenbox-openrsat <<'EOF'
#!/bin/sh
unset GTK_MODULES
exec /opt/openrsat/OpenRSAT "$@"
EOF
        chmod 0755 /usr/local/libexec/hardenbox-openrsat
        ln -sfn /usr/local/libexec/hardenbox-openrsat /usr/local/bin/openrsat
        ln -sfn /usr/local/libexec/hardenbox-openrsat /usr/local/bin/OpenRSAT
        if [ -f /usr/share/applications/OpenRSAT.desktop ]; then
            sed -i 's|^Exec=.*|Exec=/usr/local/libexec/hardenbox-openrsat|' \
                /usr/share/applications/OpenRSAT.desktop
        fi
    fi
    install -d -o root -g root -m 0755 /etc/xdg/autostart
    install -o root -g root -m 0644 /usr/share/hardenbox/samba-ad-promo-trust.desktop \
        /etc/xdg/autostart/hardenbox-samba-ad-promo-trust.desktop
    while IFS=: read -r user _ uid _ _ home _; do
        [ "$uid" -ge 1000 ] 2>/dev/null || continue
        [ "$uid" -lt 60000 ] || continue
        [ -d "$home" ] || continue
        install -d -o "$user" -g "$user" -m 0755 "$home/Bureau"
        install -o "$user" -g "$user" -m 0755 \
            /usr/share/applications/samba-ad-promo.desktop \
            "$home/Bureau/SambaADPromo.desktop"
    done </etc/passwd
fi

exit 0