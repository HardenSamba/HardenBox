#!/bin/sh

# Crochet finish-install de Harden Box (issue #8), copie par preseed/early_command.
# Il s'execute avant 06user-setup, qui efface le mot de passe de debconf, et
# conserve l'identifiant et le mot de passe du compte cree pour configurer le
# Bureau a distance au premier demarrage (hardenbox-rdp-setup.service). Le fichier
# est reserve a root et supprime des que le RDP est configure.

. /usr/share/debconf/confmodule

# Uniquement avec GNOME Remote Desktop (edition Desktop Experience).
[ -x /target/usr/bin/grdctl ] || exit 0

db_get passwd/make-user || exit 0
[ "$RET" = true ] || exit 0
db_get passwd/username || exit 0
rdp_user=$RET
db_get passwd/user-password || exit 0
rdp_password=$RET
[ -n "$rdp_user" ] && [ -n "$rdp_password" ] || exit 0

umask 077
mkdir -p /target/var/lib/hardenbox
printf '%s\n%s\n' "$rdp_user" "$rdp_password" >/target/var/lib/hardenbox/rdp-credentials
chmod 0600 /target/var/lib/hardenbox/rdp-credentials
exit 0
