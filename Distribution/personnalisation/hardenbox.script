# HARDENBOX - Debian 13 Plymouth theme

Window.SetBackgroundTopColor(0.012, 0.006, 0.030);
Window.SetBackgroundBottomColor(0.002, 0.001, 0.008);

logo.source = Image("hardenbox-icon.png");
logo.image = logo.source.Scale(220, 220);
logo.sprite = Sprite(logo.image);
logo.sprite.SetZ(10);

word.source = Image("hardenbox-wordmark.png");
word.image = word.source.Scale(350, 52);
word.sprite = Sprite(word.image);
word.sprite.SetZ(10);

progress_box.image = Image("progress-bg.png");
progress_box.sprite = Sprite(progress_box.image);
progress_box.sprite.SetZ(5);

progress_bar.original_image = Image("progress-fg.png");
progress_bar.image = progress_bar.original_image.Scale(1, progress_bar.original_image.GetHeight());
progress_bar.sprite = Sprite(progress_bar.image);
progress_bar.sprite.SetZ(6);

debian.image = Image.Text("HARDENBOX", 0.65, 0.45, 1.0);
debian.sprite = Sprite(debian.image);
debian.sprite.SetZ(10);

fun refresh_callback ()
{
    screen_width = Window.GetWidth();
    screen_height = Window.GetHeight();

    total_width = logo.image.GetWidth() + 28 + word.image.GetWidth();

    logo.x = screen_width / 2 - total_width / 2;
    logo.y = screen_height / 2 - logo.image.GetHeight() / 2 - 30;
    logo.sprite.SetPosition(logo.x, logo.y, 10);

    word.x = logo.x + logo.image.GetWidth() + 28;
    word.y = screen_height / 2 - word.image.GetHeight() / 2 - 30;
    word.sprite.SetPosition(word.x, word.y, 10);

    progress_box.x = screen_width / 2 - progress_box.image.GetWidth() / 2;
    progress_box.y = screen_height / 2 + 145;
    progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 5);

    progress_bar.x = screen_width / 2 - progress_bar.original_image.GetWidth() / 2;
    progress_bar.y = progress_box.y;
    progress_bar.sprite.SetPosition(progress_bar.x, progress_bar.y, 6);

    debian.x = screen_width / 2 - debian.image.GetWidth() / 2;
    debian.y = screen_height / 2 + 175;
    debian.sprite.SetPosition(debian.x, debian.y, 10);
}

fun progress_callback (duration, progress)
{
    if (progress < 0) progress = 0;
    if (progress > 1) progress = 1;

    width = Math.Int(progress_bar.original_image.GetWidth() * progress);

    if (width < 1) width = 1;

    progress_bar.image = progress_bar.original_image.Scale(width, progress_bar.original_image.GetHeight());
    progress_bar.sprite.SetImage(progress_bar.image);

    refresh_callback();
}

fun quit_callback ()
{
    logo.sprite.SetOpacity(1);
    word.sprite.SetOpacity(1);
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetBootProgressFunction(progress_callback);
Plymouth.SetQuitFunction(quit_callback);

refresh_callback();