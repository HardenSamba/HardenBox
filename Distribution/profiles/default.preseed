# French Debian 13.x installer defaults with preconfigured HardenBox accounts.
d-i localechooser/supported-locales multiselect fr_FR.UTF-8, en_US.UTF-8, en_GB.UTF-8
d-i console-setup/ask_detect boolean false

# Default HardenBox accounts. Passwords are stored as SHA-512 hashes.
d-i passwd/root-login boolean true
d-i passwd/make-user boolean true

d-i clock-setup/utc boolean true
d-i time/zone string Europe/Paris
d-i netcfg/choose_interface select auto
d-i netcfg/wireless_wep string
d-i debian-installer/allow_unauthenticated boolean true
d-i apt-setup/use_mirror boolean false
d-i apt-setup/cdrom/set-first boolean false
d-i apt-setup/services-select multiselect
d-i popularity-contest/participate boolean false
d-i partman-auto/disk string /dev/sda
d-i partman-auto/method string regular
d-i partman-auto/choose_recipe select atomic
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i grub-installer/only_debian boolean true
d-i grub-installer/force-efi-extra-removable boolean true
grub2 grub2/force_efi_extra_removable boolean true
d-i finish-install/reboot_in_progress note

# Load the profile chooser from simple-cdd.
d-i preseed/early_command string \
	anna-install simple-cdd-profiles ; \
	cp /cdrom/simple-cdd/hardenbox-rdp-credentials /usr/lib/finish-install.d/05hardenbox-rdp-credentials ; \
	chmod 0755 /usr/lib/finish-install.d/05hardenbox-rdp-credentials ; \
	echo 'Template: hardenbox/clock-format' > /tmp/hardenbox.templates ; \
	echo 'Type: select' >> /tmp/hardenbox.templates ; \
	echo 'Choices: 24h, 12h' >> /tmp/hardenbox.templates ; \
	echo 'Default: 24h' >> /tmp/hardenbox.templates ; \
	echo 'Description: Format horaire du systeme / System clock format' >> /tmp/hardenbox.templates ; \
	debconf-loadtemplate hardenbox /tmp/hardenbox.templates ; \
	. /usr/share/debconf/confmodule ; \
	db_fset hardenbox/clock-format seen false ; \
	db_input critical hardenbox/clock-format || true ; \
	db_go || true

# Defer profiles carrying hb-common-config until the first GUI or console session.
# secop-hardening: pick the role from the profile (samba-ad-dc when hb-sambaad is
# installed, generic otherwise) and apply the hardening once at first boot.
d-i preseed/late_command string \
	if chroot /target dpkg-query -W hb-sambaad >/dev/null 2>&1 && [ ! -s /target/var/cache/hardenbox/packages/hb-sambadws.deb ]; then \
		adws_package=$(find /cdrom/pool -type f -name 'hb-sambadws_*_all.deb' | head -n 1) ; \
		[ -n "$adws_package" ] || { echo 'ERREUR: paquet hb-sambadws absent du media' >> /target/var/log/hardenbox-installer.log ; exit 1 ; } ; \
		mkdir -p /target/var/cache/hardenbox/packages ; \
		cp "$adws_package" /target/var/cache/hardenbox/packages/hb-sambadws.deb ; \
	fi ; \
	if chroot /target dpkg-query -W hb-common-config >/dev/null 2>&1; then \
		in-target usermod -aG sudo "$(debconf-get passwd/username)" ; \
		in-target systemctl disable hb-common-bootstrap.service || true ; \
	else \
		test -x /target/usr/lib/hardenbox/hb-common-runner || { echo 'ERREUR: hb-common-runner absent du systeme cible' >> /target/var/log/hardenbox-installer.log ; exit 1 ; } ; \
		in-target /bin/sh -c 'HARDENBOX_INSTALLER=1 HARDENBOX_OFFLINE=1 /usr/lib/hardenbox/hb-common-runner >>/var/log/hardenbox-installer.log 2>&1' || exit 1 ; \
		test -s /target/var/lib/hardenbox/hb-common.completed || exit 1 ; \
		if [ -f /target/var/lib/hardenbox/hb-sambaad.conf ]; then \
			in-target /bin/sh -c 'HARDENBOX_INSTALLER=1 HARDENBOX_OFFLINE=1 /usr/lib/hardenbox/hb-sambaad-runner >>/var/log/hardenbox-installer.log 2>&1' || exit 1 ; \
			test -e /target/var/lib/hardenbox/hb-sambaad.completed || exit 1 ; \
		fi ; \
	fi ; \
	if [ -f /target/etc/secop/hardening.conf ]; then \
		if chroot /target dpkg-query -W hb-sambaad >/dev/null 2>&1; then \
			sed -i 's/^SECOP_ROLE=.*/SECOP_ROLE="samba-ad-dc"/' /target/etc/secop/hardening.conf ; \
		else \
			sed -i 's/^SECOP_ROLE=.*/SECOP_ROLE="generic"/' /target/etc/secop/hardening.conf ; \
		fi ; \
		rm -f /target/var/lib/secop-hardening/last-apply ; \
		in-target systemctl enable secop-hardening-firstboot.service || true ; \
	fi ; \
	in-target /usr/lib/hardenbox/hardenbox-iso-config --clock-format "$(debconf-get hardenbox/clock-format)" --locale "$(debconf-get debian-installer/locale)" --user "$(debconf-get passwd/username)" || true ; \
	in-target systemctl disable hb-common-bootstrap.service hb-sambaad-bootstrap.service || true
